LLM_BINDING_HOST=http://localhost:8000/v1
LLM_MODEL=your-llm-model
LLM_BINDING_API_KEY=not-required
LLM_TIMEOUT=120
LLM_JSON_RETRIES=2
OPENAI_LLM_TEMPERATURE=0
OPENAI_LLM_EXTRA_BODY={}

EMBEDDING_BINDING_HOST=http://localhost:8001/v1
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_BINDING_API_KEY=not-required
EMBEDDING_DIM=4096
EMBEDDING_BATCH_NUM=32
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_SEND_DIM=false
EMBEDDING_TIMEOUT=120

RERANK_BINDING_HOST=http://localhost:8002/v1/rerank
RERANK_MODEL=your-reranker-model
RERANK_BINDING_API_KEY=not-required
RERANK_BY_DEFAULT=true
RERANK_TIMEOUT=120
RERANK_RETRIES=2
MIN_RERANK_SCORE=0
RERANK_INSTRUCTION=Given a legal research query, retrieve legal provisions and case summaries that directly answer it. Prioritize matching facts, legal issues, jurisdictions, cited provisions, holdings, and regulatory outcomes.

LLM_CONTEXT_WINDOW=60000
EVIDENCE_TOKEN_BUDGET=42000
PLANNER_MAX_OUTPUT_TOKENS=2000
GRADER_MAX_OUTPUT_TOKENS=2000
SYNTHESIZER_MAX_OUTPUT_TOKENS=8000
PASSAGE_THRESHOLD_TOKENS=1600
PASSAGE_TARGET_TOKENS=800
PASSAGE_MAX_TOKENS=1000
PASSAGE_OVERLAP_TOKENS=100
TOKEN_SAFETY_FACTOR=1.2
