{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Legal Retrieval Benchmark Sample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "split",
    "task",
    "query",
    "language",
    "difficulty",
    "retrieval_k",
    "relevance",
    "coverage_groups",
    "expected_limitations",
    "tags",
    "annotation"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "split": {"enum": ["dev", "test"]},
    "task": {"enum": ["exact_law", "risk", "compare", "case_search"]},
    "query": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 1},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "retrieval_k": {"type": "integer", "minimum": 1, "maximum": 50},
    "relevance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "grade", "required", "rationale"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "grade": {"type": "integer", "minimum": 1, "maximum": 3},
          "required": {"type": "boolean"},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "coverage_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "evidence_ids", "min_hits"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "min_hits": {"type": "integer", "minimum": 1}
        }
      }
    },
    "expected_limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "tags": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "reviewer", "reviewed_at"],
      "properties": {
        "status": {"enum": ["draft", "silver", "gold"]},
        "method": {"type": "string", "minLength": 1},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"]}
      }
    }
  }
}
